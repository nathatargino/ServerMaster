<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ServerMaster.ViewModels.Dashboard;assembly=ServerMaster.ViewModels"
             xmlns:models="clr-namespace:ServerMaster.Core.Models;assembly=ServerMaster.Core"
             xmlns:conv="clr-namespace:ServerMaster.App.Converters"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="ServerMaster.App.Views.Dashboard.ServerDashboardView"
             x:DataType="vm:ServerDashboardViewModel"
             Background="{StaticResource BrushBgBase}">

  <UserControl.Resources>
    <conv:LogLevelToBrushConverter     x:Key="LogColor"/>
    <conv:LogLevelToLabelConverter     x:Key="LogLabel"/>
    <conv:LogLevelToPillBrushConverter x:Key="LogPill"/>
    <conv:PercentToColorBrushConverter x:Key="PctColor"/>
    <conv:ServerStateToLabelConverter  x:Key="StateLabel"/>
    <conv:ServerStateToBrushConverter  x:Key="StateBrush"/>
  </UserControl.Resources>

  <!-- Root layout: sidebar | main -->
  <Grid ColumnDefinitions="280,*">

    <!-- ══ LEFT SIDEBAR ══════════════════════════════════════════════════════ -->
    <Border Grid.Column="0"
            Background="#111520"
            BorderBrush="{StaticResource BrushBgElevated}"
            BorderThickness="0,0,1,0">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0" Spacing="0">

        <!-- Server identity header -->
        <Border Padding="16,16,16,12" Background="{StaticResource BrushBgSurface}">
          <StackPanel Spacing="8">

            <!-- Name + status pill -->
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
              <TextBlock Grid.Column="0"
                         Text="{Binding ServerName}"
                         FontSize="16" FontWeight="Bold"
                         Foreground="{StaticResource BrushTextPrimary}"
                         TextTrimming="CharacterEllipsis"/>
              <Border Grid.Column="1"
                      Background="{Binding State, Converter={StaticResource StateBrush}}"
                      CornerRadius="9999"
                      Padding="10,3">
                <TextBlock Text="{Binding State, Converter={StaticResource StateLabel}}"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextPrimary}"/>
              </Border>
            </Grid>

            <!-- Game + version row -->
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding GameType}"
                         FontSize="12" Foreground="{StaticResource BrushTextMuted}"/>
              <TextBlock Text="·" FontSize="12" Foreground="#374151"/>
              <TextBlock Text="{Binding GameVersion}"
                         FontSize="12" Foreground="{StaticResource BrushTextMuted}"/>
            </StackPanel>

            <!-- Tunnel / address -->
            <StackPanel Spacing="6">
              
              <!-- Local IP -->
              <Border Background="{StaticResource BrushBgBase}" CornerRadius="6" Padding="4">
                <Button Classes="ghost-btn" Padding="8,4" Background="Transparent" 
                        Click="CopyLocalIp_Click" ToolTip.Tip="Copiar IP Local (LAN)">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <ic:SymbolIcon Symbol="Home" VerticalAlignment="Center" FontSize="12"/>
                    <TextBlock Text="{Binding LocalAddress}"
                               FontSize="11" Foreground="{StaticResource BrushAccentPrimary}"
                               FontFamily="Cascadia Code,Consolas,monospace" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </Border>

              <!-- Playit Status Panel -->
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4" VerticalAlignment="Center">
                  <TextBlock Text="Playit (Túnel P/ Internet):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                  <Border Background="{Binding TunnelStatusColor}"
                          CornerRadius="9999"
                          Padding="8,2">
                      <TextBlock Text="{Binding TunnelStatusString}" FontSize="10" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                  </Border>
              </StackPanel>

              <!-- Tunnel IP Box (Only visible if active) -->
              <Border Background="{StaticResource BrushBgBase}" CornerRadius="6" Padding="4"
                      IsVisible="{Binding TunnelActive}">
                <Button Classes="ghost-btn" Padding="8,4" Background="Transparent" 
                        Click="CopyPublicIp_Click" ToolTip.Tip="Copiar IP Público (Playit.gg)">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <ic:SymbolIcon Symbol="Globe" VerticalAlignment="Center" FontSize="12"/>
                    <TextBlock Text="{Binding PublicAddress}"
                               FontSize="11" Foreground="{StaticResource BrushAccentPrimaryHover}"
                               FontFamily="Cascadia Code,Consolas,monospace"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </Border>
              
              <!-- ── Backup Section ── -->
              <Border Height="1" Background="{StaticResource BrushBgElevated}" Margin="0,8,0,8"/>
              
              <TextBlock Text="Backup" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
              
              <StackPanel Spacing="6">
                  <!-- Local Directory -->
                  <Button Classes="ghost-btn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" 
                          Padding="6,4" Click="SelectLocalBackupFolder_Click" ToolTip.Tip="Alterar pasta de backup local">
                      <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Left">
                              <TextBlock Text="Diretório Local" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                              <TextBlock Text="{Binding LocalBackupDirectory, FallbackValue='Nenhum selecionado'}" 
                                         FontSize="11" Foreground="{StaticResource BrushTextPrimary}"
                                         TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding LocalBackupDirectory}" />
                          </StackPanel>
                          <ic:SymbolIcon Grid.Column="1" Symbol="Folder" FontSize="14" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                      </Grid>
                  </Button>
                  
                  <!-- Google Drive -->
                  <Border Background="{StaticResource BrushBgBase}" CornerRadius="6" Padding="6,4">
                      <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Grid.Column="0" Spacing="2">
                              <CheckBox Content="Nuvem (Google Drive)" FontSize="11" Foreground="{StaticResource BrushTextPrimary}" 
                                        IsChecked="{Binding EnableGoogleDriveBackup, Mode=TwoWay}"/>
                              <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding EnableGoogleDriveBackup}">
                                  <TextBlock Text="{Binding IsGoogleDriveAuthenticated, StringFormat='{}{0}'}" 
                                             IsVisible="False" /> <!-- Trigger bindings -->
                                  <TextBlock Text="🔴 Não Autenticado" FontSize="10" Foreground="#EF4444" IsVisible="{Binding !IsGoogleDriveAuthenticated}" />
                                  <TextBlock Text="🟢 Autenticado" FontSize="10" Foreground="#22C55E" IsVisible="{Binding IsGoogleDriveAuthenticated}" />
                              </StackPanel>
                          </StackPanel>
                          
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding EnableGoogleDriveBackup}">
                              <Button Classes="ghost-btn" Padding="6,2" Command="{Binding AuthenticateGoogleDriveCommand}" IsVisible="{Binding !IsGoogleDriveAuthenticated}" ToolTip.Tip="Conectar">
                                  <ic:SymbolIcon Symbol="Link" FontSize="14"/>
                              </Button>
                              <Button Classes="ghost-btn" Padding="6,2" Command="{Binding LogoutGoogleDriveCommand}" IsVisible="{Binding IsGoogleDriveAuthenticated}" ToolTip.Tip="Desconectar">
                                  <ic:SymbolIcon Symbol="Dismiss" FontSize="14"/>
                              </Button>
                          </StackPanel>
                      </Grid>
                  </Border>

                  <Button Command="{Binding RunBackupCommand}" 
                          IsEnabled="{Binding !IsBackingUp}"
                          Classes="primary-btn" 
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Margin="0,6,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                          <ic:SymbolIcon Symbol="CloudArrowUp" VerticalAlignment="Center"/>
                          <TextBlock Text="Fazer Backup Agora" VerticalAlignment="Center"/>
                      </StackPanel>
                  </Button>
                  
                  <TextBlock Text="{Binding BackupStatusMessage}" 
                             FontSize="10" 
                             Foreground="{StaticResource BrushAccentPrimaryHover}" 
                             TextWrapping="Wrap" 
                             IsVisible="{Binding BackupStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
              
            </StackPanel>

          </StackPanel>
        </Border>

        <!-- ── Resource Gauges ─────────────────────────────── -->
        <StackPanel Margin="16,12,16,0" Spacing="12">

          <!-- CPU gauge -->
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                <TextBlock Text="CPU" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
              </StackPanel>
              <TextBlock Grid.Column="1"
                         Text="{Binding CpuPercent, StringFormat='{}{0:F1} %'}"
                         FontSize="12" FontWeight="Bold"
                         Foreground="{Binding CpuPercent, Converter={StaticResource PctColor}}"/>
            </Grid>
            <Border Background="{StaticResource BrushBgElevated}" CornerRadius="9999" Height="6" ClipToBounds="True">
              <Border HorizontalAlignment="Left"
                      Background="{Binding CpuPercent, Converter={StaticResource PctColor}}"
                      CornerRadius="9999" Height="6">
                <Border.Width>
                  <MultiBinding Converter="{x:Static conv:PercentToWidthConverter.Instance}">
                    <Binding Path="CpuPercent"/>
                    <Binding RelativeSource="{RelativeSource AncestorType=Border, AncestorLevel=1}"
                             Path="Bounds.Width"/>
                  </MultiBinding>
                </Border.Width>
                <Border.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.5" Easing="CubicEaseOut"/>
                  </Transitions>
                </Border.Transitions>
              </Border>
            </Border>
            <TextBlock Text="{Binding CpuPercent, StringFormat='{}{0:F1}% utilizado'}"
                       FontSize="10" Foreground="#4B5563"/>
          </StackPanel>

          <!-- RAM gauge -->
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="RAM" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
              <TextBlock Grid.Column="1"
                         Text="{Binding RamMb, StringFormat='{}{0} MB'}"
                         FontSize="12" FontWeight="Bold"
                         Foreground="{Binding RamPercent, Converter={StaticResource PctColor}}"/>
            </Grid>
            <Border Background="{StaticResource BrushBgElevated}" CornerRadius="9999" Height="6" ClipToBounds="True">
              <Border HorizontalAlignment="Left"
                      Background="{Binding RamPercent, Converter={StaticResource PctColor}}"
                      CornerRadius="9999" Height="6">
                <Border.Width>
                  <MultiBinding Converter="{x:Static conv:PercentToWidthConverter.Instance}">
                    <Binding Path="RamPercent"/>
                    <Binding RelativeSource="{RelativeSource AncestorType=Border, AncestorLevel=1}"
                             Path="Bounds.Width"/>
                  </MultiBinding>
                </Border.Width>
                <Border.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.5" Easing="CubicEaseOut"/>
                  </Transitions>
                </Border.Transitions>
              </Border>
            </Border>
            <TextBlock Text="{Binding RamUsageLabel}" FontSize="10" Foreground="#4B5563"/>
          </StackPanel>

          <!-- Separator -->
          <Border Height="1" Background="{StaticResource BrushBgElevated}" Margin="0,4"/>

          <!-- Stats row -->
          <UniformGrid Columns="2" ColumnSpacing="12" RowSpacing="8">

            <!-- Uptime -->
            <Border Background="{StaticResource BrushBgSurface}" CornerRadius="8" Padding="10,8">
              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ic:SymbolIcon Symbol="Clock" FontSize="10" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                    <TextBlock Text="Uptime" FontSize="10" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding UptimeDisplay}"
                           FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"
                           FontFamily="Cascadia Code,Consolas,monospace"/>
              </StackPanel>
            </Border>

            <!-- Players -->
            <Border Background="{StaticResource BrushBgSurface}" CornerRadius="8" Padding="10,8">
              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ic:SymbolIcon Symbol="People" FontSize="10" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                    <TextBlock Text="Jogadores" FontSize="10" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding OnlinePlayers, StringFormat='{}{0} online'}"
                           FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
              </StackPanel>
            </Border>

          </UniformGrid>

        </StackPanel>

        <!-- Spacer -->
        <Border Height="1" Background="{StaticResource BrushBgElevated}" Margin="16,12"/>

        <!-- Control buttons -->
        <StackPanel Margin="16,0,16,12" Spacing="6">
          <Button Command="{Binding StartServerCommand}"
                  IsVisible="{Binding !IsRunning}"
                  Classes="primary-btn"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                  <ic:SymbolIcon Symbol="Play" VerticalAlignment="Center"/>
                  <TextBlock Text="Iniciar Servidor" VerticalAlignment="Center"/>
              </StackPanel>
          </Button>
          <Button Command="{Binding StopServerCommand}"
                  IsVisible="{Binding IsRunning}"
                  Classes="danger-btn"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                  <ic:SymbolIcon Symbol="Stop" VerticalAlignment="Center"/>
                  <TextBlock Text="Parar Servidor" VerticalAlignment="Center"/>
              </StackPanel>
          </Button>
          <Button Command="{Binding RestartServerCommand}"
                  IsVisible="{Binding IsRunning}"
                  Classes="ghost-btn"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                  <ic:SymbolIcon Symbol="ArrowSync" VerticalAlignment="Center"/>
                  <TextBlock Text="Reiniciar" VerticalAlignment="Center"/>
              </StackPanel>
          </Button>
        </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- ══ MAIN AREA (Log terminal + console input) ═════════════════════════ -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

      <!-- ── Top toolbar ─── -->
      <Border Grid.Row="0"
              Background="#111520"
              BorderBrush="{StaticResource BrushBgElevated}"
              BorderThickness="0,0,0,1"
              Padding="16,10">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <Grid ColumnDefinitions="*,Auto" MinWidth="450">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
              <TextBlock Text="Console de Logs" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- Legend pills -->
                <Border Background="#14532D" CornerRadius="9999" Padding="8,3">
                  <TextBlock Text="INFO" FontSize="10" FontWeight="SemiBold" Foreground="#A3E6A3"/>
                </Border>
                <Border Background="#78350F" CornerRadius="9999" Padding="8,3">
                  <TextBlock Text="WARN" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushWarning}"/>
                </Border>
                <Border Background="#7F1D1D" CornerRadius="9999" Padding="8,3">
                  <TextBlock Text="ERR" FontSize="10" FontWeight="SemiBold" Foreground="#F87171"/>
                </Border>
                <Border Background="#1E3A5F" CornerRadius="9999" Padding="8,3">
                  <TextBlock Text="CHAT" FontSize="10" FontWeight="SemiBold" Foreground="#60A5FA"/>
                </Border>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
              <TextBox Text="{Binding LogFilter, Mode=TwoWay}"
                       PlaceholderText="🔍 Filtrar logs…"
                       Width="200"
                       Background="{StaticResource BrushBgSurface}"
                       Foreground="{StaticResource BrushTextPrimary}"
                       BorderBrush="{StaticResource BrushBorder}"
                       BorderThickness="1"
                       CornerRadius="6"
                       Padding="10,6"
                       FontSize="12"/>
              <Button Click="CopyConsole_Click"
                      Classes="ghost-btn"
                      Padding="12,6">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                      <ic:SymbolIcon Symbol="Clipboard" VerticalAlignment="Center" FontSize="14"/>
                      <TextBlock Text="Copiar" VerticalAlignment="Center"/>
                  </StackPanel>
              </Button>
              <Button Command="{Binding ClearLogsCommand}"
                      Classes="ghost-btn"
                      Padding="12,6">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                      <ic:SymbolIcon Symbol="Delete" VerticalAlignment="Center" FontSize="14"/>
                      <TextBlock Text="Limpar" VerticalAlignment="Center"/>
                  </StackPanel>
              </Button>
              <Button Classes="ghost-btn"
                      Padding="12,6"
                      ToolTip.Tip="Importar um servidor existente (ZIP ou Pasta)">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                      <ic:SymbolIcon Symbol="ArrowDownload" VerticalAlignment="Center" FontSize="14"/>
                      <TextBlock Text="Importar" VerticalAlignment="Center"/>
                  </StackPanel>
                  <Button.Flyout>
                      <MenuFlyout>
                          <MenuItem Header="Importar de arquivo (.zip)" Click="ImportServerZip_Click" />
                          <MenuItem Header="Importar de diretório (pasta)" Click="ImportServerFolder_Click" />
                      </MenuFlyout>
                  </Button.Flyout>
              </Button>
              <Button Command="{Binding ReturnToMenuCommand}"
                      Classes="ghost-btn"
                      Foreground="{StaticResource BrushTextSecondary}"
                      Padding="12,6">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                      <ic:SymbolIcon Symbol="ArrowLeft" VerticalAlignment="Center" FontSize="14"/>
                      <TextBlock Text="Voltar ao Menu" VerticalAlignment="Center"/>
                  </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Border>

      <!-- ── Log terminal ─── -->
      <Border Grid.Row="1"
              Background="#0A0C12"
              Margin="0">
        <ScrollViewer Name="LogScrollViewer"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <ItemsControl Name="LogItemsControl"
                        ItemsSource="{Binding FilteredLogs}"
                        Margin="4">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type models:LogEntry}">
                <Grid ColumnDefinitions="Auto,Auto,*"
                      Margin="4,1">

                  <!-- Timestamp -->
                  <TextBlock Grid.Column="0"
                             Text="{Binding Timestamp, StringFormat='HH:mm:ss'}"
                             FontFamily="Cascadia Code,Consolas,monospace"
                             FontSize="11"
                             Foreground="#374151"
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"/>

                  <!-- Level pill -->
                  <Border Grid.Column="1"
                          Background="{Binding Level, Converter={StaticResource LogPill}}"
                          CornerRadius="4"
                          Padding="5,1"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding Level, Converter={StaticResource LogLabel}}"
                               FontFamily="Cascadia Code,Consolas,monospace"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{Binding Level, Converter={StaticResource LogColor}}"/>
                  </Border>

                  <!-- Message -->
                  <TextBlock Grid.Column="2"
                             Text="{Binding Message}"
                             FontFamily="Cascadia Code,Consolas,monospace"
                             FontSize="12"
                             Foreground="{Binding Level, Converter={StaticResource LogColor}}"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center"/>

                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <!-- ── Console input ─── -->
      <Border Grid.Row="2"
              Background="#111520"
              BorderBrush="{StaticResource BrushBgElevated}"
              BorderThickness="0,1,0,0"
              Padding="12,10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0"
                   Name="ConsoleInput"
                   Text="{Binding ConsoleInput, Mode=TwoWay}"
                   PlaceholderText="Digite um comando e pressione Enter…"
                   Background="{StaticResource BrushBgSurface}"
                   Foreground="{StaticResource BrushTextPrimary}"
                   CaretBrush="{StaticResource BrushAccentPrimary}"
                   BorderBrush="{StaticResource BrushBorder}"
                   BorderThickness="1"
                   CornerRadius="8"
                   Padding="12,8"
                   FontFamily="Cascadia Code,Consolas,monospace"
                   FontSize="13"
                   IsEnabled="{Binding IsRunning}"/>
          <Button Grid.Column="1"
                  Command="{Binding SendConsoleInputCommand}"
                  Classes="primary-btn"
                  IsEnabled="{Binding IsRunning}"
                  Padding="16,8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Enviar" VerticalAlignment="Center"/>
                  <ic:SymbolIcon Symbol="Send" VerticalAlignment="Center" FontSize="14"/>
              </StackPanel>
          </Button>
        </Grid>
      </Border>

    </Grid>
  </Grid>
</UserControl>
