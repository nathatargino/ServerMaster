<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ServerMaster.ViewModels;assembly=ServerMaster.ViewModels"
             xmlns:dashboard="clr-namespace:ServerMaster.ViewModels.Dashboard;assembly=ServerMaster.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="ServerMaster.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
             
  <Grid RowDefinitions="Auto,*">
    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="32">
        <TextBlock Text="{Binding Greeting}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
        <TextBlock Text="Gerencie seus servidores hospedados e retome conexões anteriores." FontSize="16" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
    </StackPanel>

    <!-- Main Content -->
    <Grid Grid.Row="1" ColumnDefinitions="2*, 1*" Margin="32,0,32,32">
        
        <StackPanel Grid.Column="0" Spacing="16" Margin="0,0,24,0">
            <TextBlock Text="Meus Servidores" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Servers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource BrushBgElevated}" CornerRadius="12" Padding="16" Margin="0,0,16,12">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                         <!-- Icon -->
                         <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" Background="{StaticResource BrushBgActive}" Margin="0,0,16,0">
                            <TextBlock Text="{Binding Profile.Game}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="10" Foreground="{StaticResource BrushPrimary}"/>
                         </Border>
                         
                         <!-- Details -->
                         <StackPanel Grid.Column="1" VerticalAlignment="Center">
                             <TextBlock Text="{Binding Profile.Name}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                             <TextBlock Text="{Binding Profile.GameVersion}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
                         </StackPanel>

                         <!-- Actions -->
                         <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                             <Button IsVisible="{Binding !IsRunning}" Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).OpenServerCommand}" CommandParameter="{Binding}" Classes="primary-btn" Padding="14,8">
                                 <StackPanel Orientation="Horizontal" Spacing="8">
                                     <ic:SymbolIcon Symbol="Play" VerticalAlignment="Center"/>
                                     <TextBlock Text="Iniciar" VerticalAlignment="Center"/>
                                 </StackPanel>
                             </Button>
                             <Button IsVisible="{Binding IsRunning}" Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).OpenServerCommand}" CommandParameter="{Binding}" Classes="success-btn" Padding="14,8">
                                 <StackPanel Orientation="Horizontal" Spacing="8">
                                     <ic:SymbolIcon Symbol="Play" VerticalAlignment="Center"/>
                                     <TextBlock Text="Iniciado" VerticalAlignment="Center"/>
                                 </StackPanel>
                             </Button>
                             <Button IsVisible="{Binding IsRunning}" Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).StopServerCommand}" CommandParameter="{Binding}" Classes="danger-btn" Padding="14,8">
                                 <StackPanel Orientation="Horizontal" Spacing="8">
                                     <ic:SymbolIcon Symbol="Stop" VerticalAlignment="Center"/>
                                     <TextBlock Text="Parar" VerticalAlignment="Center"/>
                                 </StackPanel>
                             </Button>
                             <Button ToolTip.Tip="Editar servidor" Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).EditServerCommand}" CommandParameter="{Binding}" Classes="ghost-btn" Padding="10,8">
                                 <ic:SymbolIcon Symbol="Edit" FontSize="14" Foreground="{StaticResource BrushTextSecondary}"/>
                             </Button>
                             <Button ToolTip.Tip="Excluir servidor" Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).DeleteServerCommand}" CommandParameter="{Binding}" Classes="ghost-btn" Padding="10,8">
                                 <ic:SymbolIcon Symbol="Delete" FontSize="14" Foreground="#F87171"/>
                             </Button>
                         </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <!-- Right Side Panel -->
        <StackPanel Grid.Column="1" Spacing="24" VerticalAlignment="Top">
            <Border Background="{StaticResource BrushBgElevated}" CornerRadius="16" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Novo Servidor" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="Crie um novo mundo para jogar com seus amigos localmente ou via túnel global Playit." TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource BrushTextMuted}"/>
                    <Button Command="{Binding CreateNewServerCommand}" Classes="primary-btn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="16,12" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="Add" VerticalAlignment="Center"/>
                            <TextBlock Text="Criar Servidor" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            
            <Border Background="{StaticResource BrushBgElevated}" CornerRadius="16" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Túneis Playit" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                    
                    <ItemsControl ItemsSource="{Binding VisibleActiveTunnels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="dashboard:ServerDashboardViewModel">
                                <Border Background="{StaticResource BrushBgActive}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding GameType}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}"/>
                                        <TextBlock Text="{Binding ServerName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="{Binding PublicAddress}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}" IsVisible="{Binding HasPublicAddress}" TextWrapping="Wrap" />
                                        <Border HorizontalAlignment="Left" Background="{Binding TunnelStatusColor}" CornerRadius="9999" Padding="6,2" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding TunnelStatusString}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Nenhum túnel ativo no momento." IsVisible="{Binding !HasVisibleTunnels}" FontStyle="Italic" FontSize="14" Foreground="{StaticResource BrushTextMuted}" Margin="0,-8,0,8"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>


    <!-- Delete Server Modal Overlay -->
    <Grid Grid.Row="0" Grid.RowSpan="2" Background="#B2000000" IsVisible="{Binding IsDeleteModalOpen}" ZIndex="10">
        <Border Background="{StaticResource BrushBgElevated}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                Padding="32" CornerRadius="16" MinWidth="400"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BoxShadow="0 8 32 0 #40000000">
            <StackPanel Spacing="16">
                <TextBlock Text="Excluir Servidor" FontSize="20" FontWeight="Bold" Foreground="#E57373" />
                <TextBlock Text="Tem certeza que deseja excluir este servidor?" FontSize="14" Foreground="{StaticResource BrushTextSecondary}" />
                <TextBlock Text="{Binding ServerToDelete.Name, FallbackValue=''}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,8"/>
                <TextBlock Text="Esta ação não pode ser desfeita e todos os arquivos serão mantidos na pasta (mas o registro será apagado do app)." FontSize="12" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"/>
                
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Cancelar" Command="{Binding CancelDeleteServerCommand}" Classes="ghost-btn" Padding="16,8"/>
                    <Button Content="Excluir" Command="{Binding ConfirmDeleteServerCommand}" Background="#E57373" Foreground="White" Padding="16,8"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
  </Grid>
</UserControl>
